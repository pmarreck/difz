# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
annotate=[
	.mechatron-prime/targets = Exact Nix package and test attributes admitted by Mechatron Prime CI
	CODE_REVIEW.md = Upgrade-readiness review and remediation status
	README.md = Usage, architecture, security contract, limitations, build instructions, and dynamic CI badges
	docs/directory-format-v1.md = DIFZTREE v1 path, filter, identity, encoding, parser-limit, and staging contract
	docs/plan_context/mecha-delta-contract.md = Mecha delta-engine contract answers, proposed resource caps, and push-hold reasons
	scripts/flatten-static-lib = Merges thin Zig static archives into one fat libdifz.a for C consumers
	src/blar_compute.zig = Computation-only blar surface: BLIP + compression, no C FFI exports
	src/diff.zig = File delta computation plus BLAKE3 source and target identities
	src/difz.c = C CLI for file and directory diff/patch through the public FFI
	src/directory.zig = Canonical directory entries, path and hierarchy validation, and BLAKE3 tree identity
	src/directory_fs.zig = No-follow snapshots plus staged, independently rehashed filesystem reconstruction and cleanup
	src/directory_patch.zig = DIFZTREE v1 encoder, bounded parser, rule reader, checksum, and in-memory applicator
	src/encoding.zig = ZDIF v2 codec with O(op_count) index traversal and one owned INSERT allocation
	src/glob.zig = Dirtree-compatible glob-to-PCRE2 conversion with escaped wildcard handling
	src/lib.zig = Public C FFI for in-memory file deltas and staged directory patches
	src/patch.zig = Verified file reconstruction with pre-apply source and post-apply target identity checks
	src/path_filter.zig = Ordered include and exclude filter classifier with later-rule precedence
	src/pcre2.zig = UTF-8 PCRE2 wrapper for anchored path classification
	src/z7z_compute.zig = LZMA2-only z7z surface so difz does not emit z7z_* C exports
	tests/benchmark/benchmark_log_v2.csv = operation-count, peak-RSS, timing, and patch-size benchmark history
	tests/benchmark/benchmark_log_v3.csv = Linux x86_64 benchmark history with real-binary provenance and wall/CPU/RSS metrics
	tests/benchmark/corpus.bash = deterministic synthetic corpus and immutable real ELF pair validation
	tests/benchmark/results.bash = v2/v3 benchmark schemas and normalized regression calculations
	tests/benchmark/test_bm.bash = fail-closed generator, real-ELF, resource-metric, history, and claim contracts
	tests/cli/test_cli.bash = File and directory CLI integration suite with independent recursive controls
	tests/ffi/caller.c = Minimal external C consumer used to prove the installed libdifz.a link contract
	tests/ffi/test_installed_lib.bash = Links and round-trips tests/ffi/caller.c against only installed header+archive
	tests/nix/test_flake_outputs.bash = three-supported-system flake output contract
]
