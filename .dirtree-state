	src/directory_patch.zig = Sole DIFZTREE v2 codec: deterministic file deltas, omission/hardlink records, bounded parsing, checksums, source verification, and in-memory reconstruction
	src/encoding.zig = ZDIF v2 codec with O(op_count) index traversal and one owned INSERT allocation
	src/glob.zig = Dirtree-compatible glob-to-PCRE2 conversion with escaped wildcard handling
	src/inspect.zig = Pure file-patch description: codec level, source/target sizes, frame size, and both BLAKE3 identities
	src/lib.zig = Public Zig and C ABI: version, file/directory diff and apply, inspection, atomic new-file writes, progress callbacks, foreign-buffer freeing, and all-module test discovery
	src/metadata.zig = Bounded canonical metadata families, omission masks, restore plans, explicit absence, and metadata identity for DIFZTREE v2
	src/metadata_fs.zig = 
