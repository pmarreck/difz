	src/pcre2.zig = Anchored UTF-8 PCRE2 matcher used by directory path rules
	src/symlink_transport.zig = Canonical bounded parent-directory transport for unsupported symlink metadata and explicit absence
	src/z7z_compute.zig = LZMA2-only z7z surface so difz does not emit z7z_* C exports
	src/zstd_patch.zig = ZDIF v4: 85-byte header and one level-9 single-thread raw-prefix zstd frame; source/target BLAKE3 checks, bounded output, 2 GiB input/window cap, window log floor(log2(max(source,target)))+1 clamped to 10..31
	test = Complete required entry point: host metadata/CLI, Rust C ABI and codec interoperability, Nix Debug/installed-C checks, benchmark contracts, and Windows cross-build; accumulates failures
