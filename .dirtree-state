# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
annotate=[
	.mechatron-prime/targets = Exact Nix package and test attributes admitted by Mechatron Prime CI
	README.md = Usage, architecture, security contract, limitations, build instructions, and dynamic CI badges
