#!/usr/bin/env bash
# Execute Nix-prepared candidate-codec checks against the independent oracle.
set -u

if [ -z "${DIFZ_ORACLE:-}" ] || [ ! -f "$DIFZ_ORACLE" ] || [ ! -x "$DIFZ_ORACLE" ]; then
	printf 'FAIL DIFZ_ORACLE must name the independently built Zig executable\n' >&2
	exit 1
fi
if [ -z "${DIFZ_CODEC_TEST:-}" ] || [ ! -f "$DIFZ_CODEC_TEST" ] || [ ! -x "$DIFZ_CODEC_TEST" ]; then
	printf 'FAIL DIFZ_CODEC_TEST must name the Nix-prepared Rust codec test executable\n' >&2
	exit 1
fi
exec "$DIFZ_CODEC_TEST" "$@"
