#!/usr/bin/env bash
# Required candidate-codec checks against the independent Zig executable.
set -u

ROOT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
cd "$ROOT_DIR" || exit 1
if [ -z "${DIFZ_ORACLE:-}" ] || [ ! -x "$DIFZ_ORACLE" ]; then
	printf 'FAIL DIFZ_ORACLE must name the independently built Zig executable\n' >&2
	exit 1
fi
rust_host=$(rustc -vV | awk '/^host:/ {print $2}')
if [ -z "$rust_host" ]; then
	printf 'FAIL Rust host target is unavailable\n' >&2
	exit 1
fi
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$ROOT_DIR/.cache/rust-codec}"
# Linking uses the Rust toolchain's linker; codec C/C++ compilation is forbidden.
CC=false CXX=false AR=false cargo test --locked --manifest-path tests/codec_rust/Cargo.toml --target "$rust_host" --jobs 4
