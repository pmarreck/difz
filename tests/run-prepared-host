#!/usr/bin/env bash
# Run real filesystem adapters using artifacts prepared by one outer nix build.
set -u
prefix="${DIFZ_HOST_TESTS:-}"
[ -n "$prefix" ] || { printf 'FAIL DIFZ_HOST_TESTS is required\n' >&2; exit 1; }
source "${BASH_SOURCE[0]%/*}/../scripts/prepared-host-artifacts.bash" || exit 1
artifacts=(
	"$prefix/bin/difz"
	"$prefix/libexec/difz-unit-tests"
	"$prefix/bin/difz-rust-caller"
	"$prefix/bin/difz-core-consumer"
	"$prefix/bin/difz-platform-tests"
)
if [ "$(uname -s)" = Linux ]; then
	artifacts+=(
		"$prefix/libexec/difz-standalone-tests"
	)
fi
if [ "$(uname -s):$(uname -m)" = Linux:x86_64 ]; then
	artifacts+=(
		"$prefix/libexec/difz-windows-platform-amd64-release.exe"
		"$prefix/libexec/difz-windows-platform-amd64-release-tests"
		"$prefix/libexec/difz-windows-platform-amd64-debug.exe"
		"$prefix/libexec/difz-windows-platform-amd64-debug-tests"
		"$prefix/libexec/difz-windows-platform-arm64-release.exe"
		"$prefix/libexec/difz-windows-platform-arm64-release-tests"
		"$prefix/libexec/difz-windows-platform-arm64-debug.exe"
		"$prefix/libexec/difz-windows-platform-arm64-debug-tests"
	)
fi
difz_require_prepared_artifacts "${artifacts[@]}" || exit 1
errors=0
tick() {
	read -r uptime _ < /proc/uptime || return 1
	fraction="${uptime#*.}00"
	printf '%s' "$(( ${uptime%.*} * 100 + 10#${fraction:0:2} ))"
}
run_suite() {
	label=$1; shift
	log="$TMPDIR/difz-$label.log"
	start=$(tick) || return 1
	"$@" > "$log" 2>&1
	status=$?
	finish=$(tick) || return 1
	printf '%s execution: %d ms; exit=%d\n' "$label" "$(( (finish - start) * 10 ))" "$status"
	if [ "$status" -ne 0 ]; then cat "$log" >&2; else tail -2 "$log"; fi
	return "$status"
}
if ! run_suite runner-contract bash tests/integration/test_prepared_runners.bash; then errors=$((errors + 1)); fi
# shellcheck disable=SC2329
run_core() {
	# std.testing.tmpDir creates .zig-cache relative to cwd, not TMPDIR.
	(cd "$TEST_WORKSPACE" && DIFZ_REQUIRE_XATTR_TESTS=1 "$prefix/libexec/difz-unit-tests")
}
if ! run_suite core run_core; then errors=$((errors + 1)); fi
# shellcheck disable=SC2329
run_platform() {
	if [ "$(uname -s)" = Linux ]; then
		local count
		count=$("$prefix/bin/difz-platform-tests" --list | grep -c '::native_.*: test$') || return 1
		if [ "$count" -ne 29 ]; then
			printf 'FAIL expected all twenty-nine native Rust metadata fixtures\n' >&2
			return 1
		fi
	fi
	"$prefix/bin/difz-platform-tests" --test-threads=1 --include-ignored
}
if ! run_suite rust-platform run_platform; then errors=$((errors + 1)); fi
if [ "$(uname -s):$(uname -m)" = Linux:x86_64 ]; then
	for arch in amd64 arm64; do
		for profile in release debug; do
			if ! run_suite "windows-platform-$arch-$profile" "$prefix/libexec/difz-windows-platform-$arch-$profile-tests"; then errors=$((errors + 1)); fi
		done
	done
fi
if ! run_suite cli env -u DIFZ_TEST_DIRECTORY_OMIT DIFZ="$prefix/bin/difz" bash tests/cli/test_cli.bash; then errors=$((errors + 1)); fi
if ! run_suite cross-apply env DIFZ="$prefix/bin/difz" bash tests/integration/test-cross-apply.bash; then errors=$((errors + 1)); fi
if ! run_suite rust-ffi env DIFZ_RUST_CALLER="$prefix/bin/difz-rust-caller" bash tests/ffi/test_rust_lib.bash; then errors=$((errors + 1)); fi
if ! run_suite standalone "$prefix/libexec/difz-standalone-tests"; then errors=$((errors + 1)); fi
if ! run_suite growth-registry bash tests/benchmark/test-rust-growth-registry.bash "$prefix/bin/difz-core-consumer"; then errors=$((errors + 1)); fi
if ! run_suite rust-growth luajit tests/benchmark/rust-file-growth.lua "$prefix/bin/difz-core-consumer"; then errors=$((errors + 1)); fi
if ! run_suite structure-growth-registry bash tests/benchmark/test-rust-structure-registry.bash "$prefix/bin/difz-core-consumer"; then errors=$((errors + 1)); fi
if ! run_suite structure-growth luajit tests/benchmark/rust-structure-growth.lua "$prefix/bin/difz-core-consumer"; then errors=$((errors + 1)); fi
exit "$errors"
