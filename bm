info "Running hyperfine diff comparison (this may take a moment)..."

# Run hyperfine for diff operations
hyperfine \
	--warmup 3 \
	--min-runs 10 \
	--ignore-failure \
	--export-json "$HF_JSON" \
	--command-name "difz" \
	"$DIFZ --no-progress '$HF_A' '$HF_B' -o '$HF_DIFZ_D'" \
	--command-name "bsdiff" \
