}

# ── 5. Run hyperfine for the medium 90% case (detailed stats) ────────

header "Hyperfine statistical benchmark (10M, 90% similar)"

# Pre-generate files for hyperfine (they already exist from generate_test_pair)
HF_A="$TMPDIR_BM/10M_90_a"
HF_B="$TMPDIR_BM/10M_90_b"
HF_DIFZ_D="$TMPDIR_BM/hf_difz.diff"
