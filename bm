#!/usr/bin/env bash
# Benchmark suite for difz — compares speed and diff size against bsdiff, xdelta3, and zstd --patch-from.
# Usage: nix develop -c bash bm
#
# Generates deterministic test data at various sizes and similarity levels,
# then benchmarks diff/patch operations and logs results for regression tracking.

set -u

# ── Colors ────────────────────────────────────────────────────────────

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# ── Paths ─────────────────────────────────────────────────────────────

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
DIFZ="${DIFZ:-$SCRIPT_DIR/zig-out/bin/difz}"
RANDOM_BIN="${RANDOM_BIN:-random}"
BUILD_SCRIPT="${BUILD_SCRIPT:-$SCRIPT_DIR/build}"
GNU_TIME_BIN="${GNU_TIME_BIN:-$(type -P time)}"
NIX_BIN="${NIX_BIN:-nix}"
TMPDIR_BM="${TMPDIR:-/tmp}/difz-bench-$$"
LOG_DIR="$SCRIPT_DIR/tests/benchmark"
LEGACY_LOG_FILE="$LOG_DIR/benchmark_log.csv"
LOG_FILE="$LOG_DIR/benchmark_log_v3.csv"

REAL_BINARY_REPOSITORY="${REAL_BINARY_REPOSITORY:-github:pmarreck/validate}"
REAL_BINARY_SOURCE_COMMIT="${REAL_BINARY_SOURCE_COMMIT:-e3e73738a11b6401b19f18a023dfa313f77d0482}"
REAL_BINARY_TARGET_COMMIT="${REAL_BINARY_TARGET_COMMIT:-c9ab2cdb8823e69312aa90085aecf60d48fb6aa4}"
REAL_BINARY_SOURCE="${REAL_BINARY_SOURCE:-}"
REAL_BINARY_TARGET="${REAL_BINARY_TARGET:-}"

# shellcheck source=tests/benchmark/corpus.bash
source "$SCRIPT_DIR/tests/benchmark/corpus.bash"
# shellcheck source=tests/benchmark/results.bash
source "$SCRIPT_DIR/tests/benchmark/results.bash"

mkdir -p "$TMPDIR_BM" "$LOG_DIR"
trap 'rm -rf "$TMPDIR_BM"' EXIT

# ── Helper functions ──────────────────────────────────────────────────

header() {
	echo ""
	echo -e "${BOLD}${BLUE}━━━ $1 ━━━${NC}"
}

info() {
	echo -e "  ${DIM}$1${NC}"
}

ok() {
	echo -e "  ${GREEN}OK${NC} $1"
}

warn() {
	echo -e "  ${YELLOW}WARN${NC} $1"
}

err() {
	echo -e "  ${RED}ERROR${NC} $1" >&2
}

# Format bytes in human-readable form
human_bytes() {
	local bytes="$1"
	if [ "$bytes" -ge 1048576 ]; then
		echo "$(( bytes / 1048576 )).$(( (bytes % 1048576) * 10 / 1048576 ))MB"
	elif [ "$bytes" -ge 1024 ]; then
		echo "$(( bytes / 1024 )).$(( (bytes % 1024) * 10 / 1024 ))KB"
	else
		echo "${bytes}B"
	fi
}

resolve_real_binary_pair() {
	local source_output target_output

	if { [ "$REAL_BINARY_SOURCE" = "" ] && [ "$REAL_BINARY_TARGET" != "" ]; } ||
		{ [ "$REAL_BINARY_SOURCE" != "" ] && [ "$REAL_BINARY_TARGET" = "" ]; }; then
		err "REAL_BINARY_SOURCE and REAL_BINARY_TARGET must be supplied together"
		return 1
	fi
	if [ "$REAL_BINARY_SOURCE" != "" ]; then
		return 0
	fi
	if [ "$(uname -s)" != "Linux" ] || [ "$(uname -m)" != "x86_64" ]; then
		err "the pinned real-binary corpus currently requires a Linux x86_64 host"
		return 1
	fi

	info "Building Validate source revision $REAL_BINARY_SOURCE_COMMIT"
	source_output=$("$NIX_BIN" build --no-link --print-out-paths \
		"${REAL_BINARY_REPOSITORY}/${REAL_BINARY_SOURCE_COMMIT}#packages.x86_64-linux.default") || return 1
	info "Building Validate target revision $REAL_BINARY_TARGET_COMMIT"
	target_output=$("$NIX_BIN" build --no-link --print-out-paths \
		"${REAL_BINARY_REPOSITORY}/${REAL_BINARY_TARGET_COMMIT}#packages.x86_64-linux.default") || return 1
	REAL_BINARY_SOURCE="$(printf '%s\n' "$source_output" | tail -n1)/bin/validate"
	REAL_BINARY_TARGET="$(printf '%s\n' "$target_output" | tail -n1)/bin/validate"
}

host_cpu_model() {
	local model
	if [ -r /proc/cpuinfo ]; then
		model=$(awk -F: '/^model name[[:space:]]*:/ { sub(/^[[:space:]]+/, "", $2); print $2; exit }' /proc/cpuinfo)
	elif type sysctl >/dev/null 2>&1; then
		model=$(sysctl -n machdep.cpu.brand_string 2>/dev/null)
	else
		model=unknown
	fi
	printf '%s\n' "${model:-unknown}" | tr ',' ';'
}

# Generate a test file pair with a given similarity percentage.
# The first $keep bytes of _b are copied from _a; the rest are different (seeded).
# This isn't perfectly scattered similarity, but it's deterministic and fast.
generate_test_pair() {
	local name="$1" size="$2" similarity="$3" seed="$4"
	local file_a="$TMPDIR_BM/${name}_a"
	local file_b="$TMPDIR_BM/${name}_b"
	local actual_size

	if [ "$size" -le 0 ]; then
		err "$name declares a non-positive fixture size: $size"
		return 1
	fi

	# Create file_a from deterministic seeded random bytes
	if ! "$RANDOM_BIN" --seed "$seed" -b -c "$size" > "$file_a" 2>/dev/null; then
		err "random failed while generating $file_a"
		return 1
	fi
	actual_size=$(wc -c < "$file_a" | tr -d ' ')
	if [ "$actual_size" -ne "$size" ]; then
		err "$file_a has $actual_size bytes; expected $size"
		return 1
	fi

	# Create file_b: deterministic but different (seed + 10000)
	if ! "$RANDOM_BIN" --seed "$(( seed + 10000 ))" -b -c "$size" > "$file_b" 2>/dev/null; then
		err "random failed while generating $file_b"
		return 1
	fi
	actual_size=$(wc -c < "$file_b" | tr -d ' ')
	if [ "$actual_size" -ne "$size" ]; then
		err "$file_b has $actual_size bytes; expected $size"
		return 1
	fi

	# Rebuild B from A's shared prefix plus B's random suffix. Avoid bytewise
	# in-place writes, which are slow and can be rejected by safe dd wrappers.
	local keep=$(( size * similarity / 100 ))
	if [ "$keep" -gt 0 ]; then
		local rebuilt_b="$TMPDIR_BM/${name}_b.rebuilt"
		if ! head -c "$keep" "$file_a" > "$rebuilt_b"; then
			err "could not read the shared prefix for $name"
			return 1
		fi
		if [ "$keep" -lt "$size" ] &&
			! tail -c "+$(( keep + 1 ))" "$file_b" >> "$rebuilt_b"; then
			err "could not read the random suffix for $name"
			return 1
		fi
		if ! mv "$rebuilt_b" "$file_b"; then
			err "could not install rebuilt target for $name"
			return 1
		fi
	fi
	actual_size=$(wc -c < "$file_b" | tr -d ' ')
	if [ "$actual_size" -ne "$size" ]; then
		err "$file_b has $actual_size bytes after prefix assembly; expected $size"
		return 1
	fi

	info "  ${name}: $(human_bytes "$size"), ${similarity}% similar (seed=$seed)"
}

# macOS date doesn't support %N. Detect and use a fallback.
has_date_ns() {
	local test_val
	test_val=$(date +%s%N 2>/dev/null)
	# On macOS, date +%s%N outputs the epoch followed by literal "N"
	if echo "$test_val" | grep -q 'N'; then
		return 1
	fi
	return 0
}

# Portable nanosecond timestamp
now_ns() {
	if has_date_ns; then
		date +%s%N
	else
		# macOS fallback using perl (always available)
		perl -MTime::HiRes=time -e 'printf "%d\n", time()*1e9'
	fi
}

# Run a single timed command and capture wall time, CPU time, and peak memory.
# Outputs: <wall_ms> <cpu_ms> <peak_rss_kib> <exit_code>
time_cmd() {
	local start end elapsed rc cpu_ms peak_rss
	local resource_file="$TMPDIR_BM/time-resources"
	start=$(now_ns)
	"$GNU_TIME_BIN" -f '%U %S %M' -o "$resource_file" "$@" > /dev/null 2>&1
	rc=$?
	end=$(now_ns)
	elapsed=$(( (end - start) / 1000000 ))
	cpu_ms=$(awk '{ printf "%.0f", ($1 + $2) * 1000 }' "$resource_file")
	peak_rss=$(awk '{ print $3 }' "$resource_file")
	if ! echo "$cpu_ms" | grep -qE '^[0-9]+$'; then
		cpu_ms=0
	fi
	if ! echo "$peak_rss" | grep -qE '^[0-9]+$'; then
		peak_rss=0
	fi
	echo "$elapsed $cpu_ms $peak_rss $rc"
}

# Format a time value: append "ms" only for numeric values
fmt_time() {
	local val="$1"
	if echo "$val" | grep -qE '^[0-9]+$'; then
		echo "${val}ms"
	else
		echo "$val"
	fi
}

# ── 1. Build ──────────────────────────────────────────────────────────

header "Building difz (ReleaseFast)"

if ! "$BUILD_SCRIPT" 2>&1; then
	err "Build failed!"
	exit 1
fi

if [ ! -x "$DIFZ" ]; then
	err "difz binary not found at $DIFZ"
	exit 1
fi
ok "Build succeeded"

# ── 2. Assert not a debug build ──────────────────────────────────────

about_output=$("$DIFZ" --about 2>&1 || true)
if echo "$about_output" | grep -q "DEBUG BUILD"; then
	err "difz appears to be a DEBUG BUILD! Benchmarks require ReleaseFast."
	err "Output: $about_output"
	exit 1
fi
ok "Confirmed ReleaseFast build"
info "$about_output"

# ── 3. Generate test data ────────────────────────────────────────────

header "Generating test data"

# Name              Size        Similarity  Seed
generate_test_pair "1M_90"     1048576    90          42 || exit 1
generate_test_pair "10M_90"    10485760   90          43 || exit 1
generate_test_pair "20M_90"    20971520   90          44 || exit 1
generate_test_pair "50M_90"    52428800   90          45 || exit 1
generate_test_pair "20M_99"    20971520   99          46 || exit 1
generate_test_pair "20M_50"    20971520   50          47 || exit 1
generate_interleaved_pair "$RANDOM_BIN" "$TMPDIR_BM" "1M_interleaved" 1048576 9001 || exit 1
resolve_real_binary_pair || exit 1
install_real_elf_pair "$TMPDIR_BM" "validate_real_update" \
	"$REAL_BINARY_SOURCE" "$REAL_BINARY_TARGET" "$REAL_BINARY_REPOSITORY" \
	"$REAL_BINARY_SOURCE_COMMIT" "$REAL_BINARY_TARGET_COMMIT" || exit 1

ok "Test data generated in $TMPDIR_BM"

# ── 4. Benchmark functions ────────────────────────────────────────────

# Arrays to accumulate results for summary table
declare -a BM_NAMES=()
declare -a BM_DIFZ_DIFF_MS=()
declare -a BM_DIFZ_DIFF_CPU_MS=()
declare -a BM_BSDIFF_DIFF_MS=()
declare -a BM_BSDIFF_DIFF_CPU_MS=()
declare -a BM_XDELTA_DIFF_MS=()
declare -a BM_XDELTA_DIFF_CPU_MS=()
declare -a BM_DIFZ_PATCH_MS=()
declare -a BM_DIFZ_PATCH_CPU_MS=()
declare -a BM_BSPATCH_PATCH_MS=()
declare -a BM_BSPATCH_PATCH_CPU_MS=()
declare -a BM_XDELTA_PATCH_MS=()
declare -a BM_XDELTA_PATCH_CPU_MS=()
declare -a BM_DIFZ_SIZE=()
declare -a BM_BSDIFF_SIZE=()
declare -a BM_XDELTA_SIZE=()
declare -a BM_ZSTD_DIFF_MS=()
declare -a BM_ZSTD_DIFF_CPU_MS=()
declare -a BM_ZSTD_PATCH_MS=()
declare -a BM_ZSTD_PATCH_CPU_MS=()
declare -a BM_ZSTD_SIZE=()
declare -a BM_FILE_SIZE=()
declare -a BM_TARGET_SIZE=()
declare -a BM_CORPUS_SHAPE=()
declare -a BM_OP_COUNT=()
declare -a BM_MIN_OPS=()
declare -a BM_DIFZ_DIFF_RSS_KB=()
declare -a BM_DIFZ_PATCH_RSS_KB=()
declare -a BM_INPUT_REPOSITORY=()
declare -a BM_SOURCE_REVISION=()
declare -a BM_TARGET_REVISION=()
declare -a BM_SOURCE_SHA256=()
declare -a BM_TARGET_SHA256=()

run_benchmark() {
	local name="$1"
	local corpus_shape="$2"
	local min_ops="$3"
	local input_repository="${4:-synthetic:random}"
	local source_revision="${5:-none}"
	local target_revision="${6:-none}"
	local file_a="$TMPDIR_BM/${name}_a"
	local file_b="$TMPDIR_BM/${name}_b"
	local file_size target_size source_sha256 target_sha256
	file_size=$(wc -c < "$file_a" | tr -d ' ')
	target_size=$(wc -c < "$file_b" | tr -d ' ')
	source_sha256=$(sha256sum "$file_a" | cut -d' ' -f1)
	target_sha256=$(sha256sum "$file_b" | cut -d' ' -f1)
	if [ "$file_size" -le 0 ] || [ "$target_size" -le 0 ]; then
		err "$name contains an empty benchmark input"
		return 1
	fi

	local difz_diff="$TMPDIR_BM/${name}_difz.diff"
	local bsdiff_diff="$TMPDIR_BM/${name}_bsdiff.diff"
	local xdelta_diff="$TMPDIR_BM/${name}_xdelta.diff"
	local zstd_diff="$TMPDIR_BM/${name}_zstd.diff"

	local difz_recon="$TMPDIR_BM/${name}_difz_recon"
	local bsdiff_recon="$TMPDIR_BM/${name}_bsdiff_recon"
	local xdelta_recon="$TMPDIR_BM/${name}_xdelta_recon"
	local zstd_recon="$TMPDIR_BM/${name}_zstd_recon"

	header "Benchmark: $name ($(human_bytes "$file_size"))"

	# ── Diff benchmarks ──
	echo -e "  ${CYAN}Diff speed:${NC}"

	local result rc ms cpu_ms

	# difz diff
	result=$(time_cmd "$DIFZ" --no-progress "$file_a" "$file_b" -o "$difz_diff")
	ms=$(echo "$result" | cut -d' ' -f1)
	cpu_ms=$(echo "$result" | cut -d' ' -f2)
	local difz_diff_rss_kb
	difz_diff_rss_kb=$(echo "$result" | cut -d' ' -f3)
	rc=$(echo "$result" | cut -d' ' -f4)
	if [ "$rc" -ne 0 ]; then
		warn "difz diff failed (rc=$rc)"
		ms="FAIL"
		cpu_ms="FAIL"
	fi
	local difz_diff_ms="$ms"
	local difz_diff_cpu_ms="$cpu_ms"
	info "  difz:   $(fmt_time "$difz_diff_ms") wall, $(fmt_time "$difz_diff_cpu_ms") CPU, peak RSS ${difz_diff_rss_kb} KiB"

	local op_count=0
	if [ "$difz_diff_ms" != "FAIL" ] && [ -f "$difz_diff" ]; then
		local inspect_file="$TMPDIR_BM/${name}_inspect.txt"
		if ! "$DIFZ" --inspect --truncate 0 "$difz_diff" > "$inspect_file" 2>/dev/null; then
			err "$name operation count inspection failed"
			return 1
		fi
		op_count=$(sed -n 's/^difz inspect: \([0-9][0-9]*\) ops,.*/\1/p' "$inspect_file")
		if ! echo "$op_count" | grep -qE '^[0-9]+$'; then
			err "$name operation count could not be parsed"
			return 1
		fi
		if [ "$op_count" -lt "$min_ops" ]; then
			err "$name produced $op_count operations; minimum is $min_ops"
			return 1
		fi
		info "  operations: $op_count (minimum $min_ops)"
	fi

	# bsdiff diff
	result=$(time_cmd bsdiff "$file_a" "$file_b" "$bsdiff_diff")
	ms=$(echo "$result" | cut -d' ' -f1)
	cpu_ms=$(echo "$result" | cut -d' ' -f2)
	rc=$(echo "$result" | cut -d' ' -f4)
	if [ "$rc" -ne 0 ]; then
		warn "bsdiff failed (rc=$rc)"
		ms="FAIL"
		cpu_ms="FAIL"
	fi
	local bsdiff_diff_ms="$ms"
	local bsdiff_diff_cpu_ms="$cpu_ms"
	info "  bsdiff:  $(fmt_time "$bsdiff_diff_ms") wall, $(fmt_time "$bsdiff_diff_cpu_ms") CPU"

	# xdelta3 diff
	result=$(time_cmd xdelta3 -f -e -s "$file_a" "$file_b" "$xdelta_diff")
	ms=$(echo "$result" | cut -d' ' -f1)
	cpu_ms=$(echo "$result" | cut -d' ' -f2)
	rc=$(echo "$result" | cut -d' ' -f4)
	if [ "$rc" -ne 0 ]; then
		warn "xdelta3 failed (rc=$rc)"
		ms="FAIL"
		cpu_ms="FAIL"
	fi
	local xdelta_diff_ms="$ms"
	local xdelta_diff_cpu_ms="$cpu_ms"
	info "  xdelta3: $(fmt_time "$xdelta_diff_ms") wall, $(fmt_time "$xdelta_diff_cpu_ms") CPU"

	# zstd --patch-from diff
	result=$(time_cmd zstd -f --patch-from="$file_a" "$file_b" -o "$zstd_diff")
	ms=$(echo "$result" | cut -d' ' -f1)
	cpu_ms=$(echo "$result" | cut -d' ' -f2)
	rc=$(echo "$result" | cut -d' ' -f4)
	if [ "$rc" -ne 0 ]; then
		warn "zstd --patch-from failed (rc=$rc)"
		ms="FAIL"
		cpu_ms="FAIL"
	fi
	local zstd_diff_ms="$ms"
	local zstd_diff_cpu_ms="$cpu_ms"
	info "  zstd:    $(fmt_time "$zstd_diff_ms") wall, $(fmt_time "$zstd_diff_cpu_ms") CPU"

	# ── Patch benchmarks ──
	echo -e "  ${CYAN}Patch speed:${NC}"

	# difz patch
	if [ -f "$difz_diff" ]; then
		result=$(time_cmd "$DIFZ" --patch --no-progress "$file_a" "$difz_diff" -o "$difz_recon")
		ms=$(echo "$result" | cut -d' ' -f1)
		cpu_ms=$(echo "$result" | cut -d' ' -f2)
		local difz_patch_rss_kb
		difz_patch_rss_kb=$(echo "$result" | cut -d' ' -f3)
		rc=$(echo "$result" | cut -d' ' -f4)
		if [ "$rc" -ne 0 ]; then
			warn "difz patch failed (rc=$rc)"
			ms="FAIL"
			cpu_ms="FAIL"
		else
			# Verify correctness
			if ! cmp -s "$file_b" "$difz_recon"; then
				warn "difz patch produced incorrect output!"
				ms="WRONG"
				cpu_ms="WRONG"
			fi
		fi
	else
		ms="SKIP"
		cpu_ms="SKIP"
		difz_patch_rss_kb=0
	fi
	local difz_patch_ms="$ms"
	local difz_patch_cpu_ms="$cpu_ms"
	info "  difz:   $(fmt_time "$difz_patch_ms") wall, $(fmt_time "$difz_patch_cpu_ms") CPU, peak RSS ${difz_patch_rss_kb} KiB"

	# bspatch
	if [ -f "$bsdiff_diff" ]; then
		result=$(time_cmd bspatch "$file_a" "$bsdiff_recon" "$bsdiff_diff")
		ms=$(echo "$result" | cut -d' ' -f1)
		cpu_ms=$(echo "$result" | cut -d' ' -f2)
		rc=$(echo "$result" | cut -d' ' -f4)
		if [ "$rc" -ne 0 ]; then
			warn "bspatch failed (rc=$rc)"
			ms="FAIL"
			cpu_ms="FAIL"
		else
			if ! cmp -s "$file_b" "$bsdiff_recon"; then
				warn "bspatch produced incorrect output!"
				ms="WRONG"
				cpu_ms="WRONG"
			fi
		fi
	else
		ms="SKIP"
		cpu_ms="SKIP"
	fi
	local bspatch_patch_ms="$ms"
	local bspatch_patch_cpu_ms="$cpu_ms"
	info "  bspatch: $(fmt_time "$bspatch_patch_ms") wall, $(fmt_time "$bspatch_patch_cpu_ms") CPU"

	# xdelta3 decode
	if [ -f "$xdelta_diff" ]; then
		result=$(time_cmd xdelta3 -f -d -s "$file_a" "$xdelta_diff" "$xdelta_recon")
		ms=$(echo "$result" | cut -d' ' -f1)
		cpu_ms=$(echo "$result" | cut -d' ' -f2)
		rc=$(echo "$result" | cut -d' ' -f4)
		if [ "$rc" -ne 0 ]; then
			warn "xdelta3 decode failed (rc=$rc)"
			ms="FAIL"
			cpu_ms="FAIL"
		else
			if ! cmp -s "$file_b" "$xdelta_recon"; then
				warn "xdelta3 decode produced incorrect output!"
				ms="WRONG"
				cpu_ms="WRONG"
			fi
		fi
	else
		ms="SKIP"
		cpu_ms="SKIP"
	fi
	local xdelta_patch_ms="$ms"
	local xdelta_patch_cpu_ms="$cpu_ms"
	info "  xdelta3: $(fmt_time "$xdelta_patch_ms") wall, $(fmt_time "$xdelta_patch_cpu_ms") CPU"

	# zstd patch
	if [ -f "$zstd_diff" ]; then
		result=$(time_cmd zstd -d -f --patch-from="$file_a" "$zstd_diff" -o "$zstd_recon")
		ms=$(echo "$result" | cut -d' ' -f1)
		cpu_ms=$(echo "$result" | cut -d' ' -f2)
		rc=$(echo "$result" | cut -d' ' -f4)
		if [ "$rc" -ne 0 ]; then
			warn "zstd decode failed (rc=$rc)"
			ms="FAIL"
			cpu_ms="FAIL"
		else
			if ! cmp -s "$file_b" "$zstd_recon"; then
				warn "zstd decode produced incorrect output!"
				ms="WRONG"
				cpu_ms="WRONG"
			fi
		fi
	else
		ms="SKIP"
		cpu_ms="SKIP"
	fi
	local zstd_patch_ms="$ms"
	local zstd_patch_cpu_ms="$cpu_ms"
	info "  zstd:    $(fmt_time "$zstd_patch_ms") wall, $(fmt_time "$zstd_patch_cpu_ms") CPU"

	# ── Diff sizes ──
	echo -e "  ${CYAN}Diff sizes:${NC}"

	local difz_sz=0 bsdiff_sz=0 xdelta_sz=0
	if [ -f "$difz_diff" ]; then
		difz_sz=$(wc -c < "$difz_diff" | tr -d ' ')
		info "  difz:   $(human_bytes "$difz_sz") ($difz_sz bytes)"
	else
		info "  difz:   N/A"
	fi
	if [ -f "$bsdiff_diff" ]; then
		bsdiff_sz=$(wc -c < "$bsdiff_diff" | tr -d ' ')
		info "  bsdiff:  $(human_bytes "$bsdiff_sz") ($bsdiff_sz bytes)"
	else
		info "  bsdiff:  N/A"
	fi
	if [ -f "$xdelta_diff" ]; then
		xdelta_sz=$(wc -c < "$xdelta_diff" | tr -d ' ')
		info "  xdelta3: $(human_bytes "$xdelta_sz") ($xdelta_sz bytes)"
	else
		info "  xdelta3: N/A"
	fi
	local zstd_sz=0
	if [ -f "$zstd_diff" ]; then
		zstd_sz=$(wc -c < "$zstd_diff" | tr -d ' ')
		info "  zstd:    $(human_bytes "$zstd_sz") ($zstd_sz bytes)"
	else
		info "  zstd:    N/A"
	fi

	# Accumulate results
	BM_NAMES+=("$name")
	BM_FILE_SIZE+=("$file_size")
	BM_TARGET_SIZE+=("$target_size")
	BM_CORPUS_SHAPE+=("$corpus_shape")
	BM_OP_COUNT+=("$op_count")
	BM_MIN_OPS+=("$min_ops")
	BM_INPUT_REPOSITORY+=("$input_repository")
	BM_SOURCE_REVISION+=("$source_revision")
	BM_TARGET_REVISION+=("$target_revision")
	BM_SOURCE_SHA256+=("$source_sha256")
	BM_TARGET_SHA256+=("$target_sha256")
	BM_DIFZ_DIFF_MS+=("$difz_diff_ms")
	BM_DIFZ_DIFF_CPU_MS+=("$difz_diff_cpu_ms")
	BM_DIFZ_DIFF_RSS_KB+=("$difz_diff_rss_kb")
	BM_BSDIFF_DIFF_MS+=("$bsdiff_diff_ms")
	BM_BSDIFF_DIFF_CPU_MS+=("$bsdiff_diff_cpu_ms")
	BM_XDELTA_DIFF_MS+=("$xdelta_diff_ms")
