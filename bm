# ── 9. Regression detection ──────────────────────────────────────────

header "Regression check"

REGRESSIONS=0
PREVIOUS_RUNS=0

for i in "${!BM_NAMES[@]}"; do
	test_name="${BM_NAMES[$i]}"
	prev_row=$(awk -F, -v timestamp="$TIMESTAMP" -v host_os="$HOST_OS" \
		-v host_arch="$HOST_ARCH" -v cpu_model="$CPU_MODEL" -v test_name="$test_name" \
		-v source_hash="${BM_SOURCE_SHA256[$i]}" -v target_hash="${BM_TARGET_SHA256[$i]}" '
		$1 != timestamp && $2 == host_os && $3 == host_arch && $4 == cpu_model &&
		$6 == test_name && $11 == source_hash && $12 == target_hash { row = $0 }
		END { print row }
	' "$LOG_FILE")
	if [ -z "$prev_row" ]; then
		continue
	fi
	PREVIOUS_RUNS=$((PREVIOUS_RUNS + 1))

	prev_ops=$(echo "$prev_row" | cut -d',' -f15)
	prev_diff_ms=$(echo "$prev_row" | cut -d',' -f17)
	prev_diff_cpu_ms=$(echo "$prev_row" | cut -d',' -f18)
	prev_patch_ms=$(echo "$prev_row" | cut -d',' -f26)
	prev_patch_cpu_ms=$(echo "$prev_row" | cut -d',' -f27)
	prev_patch_rss_kb=$(echo "$prev_row" | cut -d',' -f28)
	prev_difz_size=$(echo "$prev_row" | cut -d',' -f35)
	curr_ops="${BM_OP_COUNT[$i]}"
	curr_diff_ms="${BM_DIFZ_DIFF_MS[$i]}"
	curr_diff_cpu_ms="${BM_DIFZ_DIFF_CPU_MS[$i]}"
	curr_patch_ms="${BM_DIFZ_PATCH_MS[$i]}"
	curr_patch_cpu_ms="${BM_DIFZ_PATCH_CPU_MS[$i]}"
	curr_patch_rss_kb="${BM_DIFZ_PATCH_RSS_KB[$i]}"
	curr_difz_size="${BM_DIFZ_SIZE[$i]}"

	for value in "$prev_ops" "$prev_diff_ms" "$prev_diff_cpu_ms" \
		"$prev_patch_ms" "$prev_patch_cpu_ms" "$prev_patch_rss_kb" \
		"$prev_difz_size" "$curr_ops" "$curr_diff_ms" "$curr_diff_cpu_ms" \
		"$curr_patch_ms" "$curr_patch_cpu_ms" "$curr_patch_rss_kb" \
		"$curr_difz_size"; do
		if ! echo "$value" | grep -qE '^[0-9]+$'; then
			warn "$test_name: skipped regression checks because a metric is non-numeric"
			continue 2
		fi
	done

	if metric_regressed "$prev_diff_ms" "$curr_diff_ms" 10; then
		warn "$test_name: diff wall time regressed: ${prev_diff_ms}ms -> ${curr_diff_ms}ms (>10%)"
		REGRESSIONS=$((REGRESSIONS + 1))
	fi
	if metric_regressed "$prev_diff_cpu_ms" "$curr_diff_cpu_ms" 10; then
		warn "$test_name: diff CPU time regressed: ${prev_diff_cpu_ms}ms -> ${curr_diff_cpu_ms}ms (>10%)"
		REGRESSIONS=$((REGRESSIONS + 1))
	fi
	if apply_complexity_regressed "$prev_patch_ms" "$prev_ops" "$curr_patch_ms" "$curr_ops" 25; then
		warn "$test_name: apply wall milliseconds per operation regressed by more than 25%"
		REGRESSIONS=$((REGRESSIONS + 1))
	fi
	if apply_complexity_regressed "$prev_patch_cpu_ms" "$prev_ops" "$curr_patch_cpu_ms" "$curr_ops" 25; then
		warn "$test_name: apply CPU milliseconds per operation regressed by more than 25%"
		REGRESSIONS=$((REGRESSIONS + 1))
	fi
	if metric_regressed "$prev_patch_rss_kb" "$curr_patch_rss_kb" 25; then
		warn "$test_name: apply peak RSS regressed: ${prev_patch_rss_kb} -> ${curr_patch_rss_kb} KiB (>25%)"
		REGRESSIONS=$((REGRESSIONS + 1))
	fi
	if metric_regressed "$prev_difz_size" "$curr_difz_size" 10; then
		warn "$test_name: patch size regressed: ${prev_difz_size} -> ${curr_difz_size} bytes (>10%)"
		REGRESSIONS=$((REGRESSIONS + 1))
	fi
done

if [ "$PREVIOUS_RUNS" -eq 0 ]; then
	info "No prior v3 row matches this host and corpus identity"
elif [ "$REGRESSIONS" -eq 0 ]; then
	ok "No wall-time, CPU-time, per-operation apply, peak-RSS, or patch-size regressions"
else
	err "$REGRESSIONS benchmark regression(s) exceeded their thresholds"
fi

# ── Done ──────────────────────────────────────────────────────────────

header "Done"
echo -e "  ${GREEN}Benchmark complete.${NC} Results logged to:"
info "$LOG_FILE"
echo ""

if [ "$REGRESSIONS" -ne 0 ]; then
	exit 1
fi
