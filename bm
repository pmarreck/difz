	--ignore-failure \
	--export-json "$HF_JSON_PATCH" \
	--command-name "difz patch" \
	"$DIFZ --patch --no-progress '$HF_A' '$HF_DIFZ_D' -o '$TMPDIR_BM/hf_difz_recon'" \
	--command-name "bspatch" \
	"bspatch '$HF_A' '$TMPDIR_BM/hf_bspatch_recon' '$HF_BSDIFF_D'" \
	--command-name "xdelta3 decode" \
	"xdelta3 -f -d -s '$HF_A' '$HF_XDELTA_D' '$TMPDIR_BM/hf_xdelta_recon'" \
	--command-name "zstd decode" \
	"zstd -d -f --patch-from='$HF_A' '$HF_ZSTD_D' -o '$TMPDIR_BM/hf_zstd_recon'" \
	2>&1 || warn "hyperfine patch benchmark had issues"

