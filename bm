	--command-name "zstd" \
	"zstd -f --patch-from='$HF_A' '$HF_B' -o '$HF_ZSTD_D'" \
	2>&1 || warn "hyperfine diff benchmark had issues"

echo ""

# Now run hyperfine for patch operations (need diff files to exist first)
"$DIFZ" --no-progress "$HF_A" "$HF_B" -o "$HF_DIFZ_D" 2>/dev/null
bsdiff "$HF_A" "$HF_B" "$HF_BSDIFF_D" 2>/dev/null
