#!/usr/bin/env bash
set -uo pipefail

run() {
  "$@" || {
    echo "FAILED: $*" >&2
    exit 1
  }
}

target=".#default"
if [[ "${1:-}" == "debug" ]]; then
  target=".#debug"
  shift
fi

if ! command -v nix >/dev/null 2>&1; then
  printf 'build: Nix is required; install Nix with flakes enabled.\n' >&2
  exit 69
fi

if ! prefix=$(nix build --no-update-lock-file --print-out-paths "$target" "$@"); then
  printf 'build: Nix build failed.\n' >&2
  exit 1
fi
if [[ -z "$prefix" || "$prefix" = *$'\n'* || ! -f "$prefix/bin/difz" || ! -x "$prefix/bin/difz" ]]; then
  printf 'build: Nix did not return one prepared difz executable.\n' >&2
  exit 1
fi
run mkdir -p zig-out/bin
run install -m755 "$prefix/bin/difz" zig-out/bin/difz
