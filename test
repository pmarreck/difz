#!/usr/bin/env bash

# Run all difz tests in Debug mode through the canonical Nix check.

set -u

errors=0

if ! tests/nix/test_flake_outputs.bash; then
	errors=$((errors + 1))
fi

system="$(nix eval --impure --raw --expr builtins.currentSystem)"
if ! nix build -L \
	".#checks.${system}.test" \
	".#checks.${system}.benchmark-contract"; then
	errors=$((errors + 1))
fi

exit "$errors"
