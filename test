#!/usr/bin/env bash
# Prepare every artifact through Nix, then exercise host adapters in confinement.
set -u
cd "$(dirname "$0")" || exit 1
errors=0
manifest=$(mktemp "${TMPDIR:-/tmp}/difz-test-build.XXXXXXXX") || exit 1
trap 'rm -f -- "$manifest"' EXIT
clock_tick() {
	if [ -r /proc/uptime ]; then
		read -r uptime _ < /proc/uptime
		fraction="${uptime#*.}00"
		printf '%s' "$(( ${uptime%.*} * 100 + 10#${fraction:0:2} ))"
	else
		printf unknown
	fi
}
elapsed() {
	if [ "$1" = unknown ] || [ "$2" = unknown ]; then printf unknown; else
		delta=$(( $2 - $1 ))
		printf '%d.%02d s' "$((delta / 100))" "$((delta % 100))"
	fi
}
started=$(clock_tick)
printf 'Checking flake contracts and preparing all test artifacts through Nix...\n'
if ! nix develop --no-update-lock-file -c bash tests/nix/test_flake_outputs.bash; then errors=$((errors + 1)); fi
system=$(nix eval --impure --raw --expr builtins.currentSystem) || exit 1
if nix build --no-update-lock-file --no-link --json -L \
	".#packages.${system}.host-tests" \
	".#checks.${system}.test" \
	".#checks.${system}.benchmark-contract" \
	".#checks.${system}.rust-codec" \
	".#checks.${system}.rust-ffi" \
	".#checks.${system}.windows-gnu" > "$manifest"; then
	prepared=1
else
	errors=$((errors + 1)); prepared=0
fi
prepared_at=$(clock_tick)
printf 'Nix preparation and sandbox checks: %s (evaluation, builds, and cached/fresh checks combined).\n' "$(elapsed "$started" "$prepared_at")"
if [ "$prepared" -eq 1 ]; then
	prefix=$(nix develop --no-update-lock-file -c jq -er '
		[ .[] | .outputs.out | select(endswith("-difz-host-tests")) ] |
		if length == 1 then .[0] else error("expected one prepared host-test output") end
	' "$manifest") || exit 1
	printf 'Running prepared host tests within the verified filesystem boundary...\n'
	if [ "$(uname -s)" = Linux ] && command -v build-budget >/dev/null 2>&1; then
		build-budget --project difz -- nix develop --no-update-lock-file -c bash tests/run-host-tests "$prefix"
		status=$?
	else
		nix develop --no-update-lock-file -c bash tests/run-host-tests "$prefix"
		status=$?
	fi
	[ "$status" -eq 0 ] || errors=$((errors + 1))
else
	printf 'INCOMPLETE host execution: Nix preparation failed.\n' >&2
fi
finished=$(clock_tick)
printf 'Host execution phase including environment/admission: %s; total: %s; failures: %d\n' \
	"$(elapsed "$prepared_at" "$finished")" "$(elapsed "$started" "$finished")" "$errors"
exit "$errors"
