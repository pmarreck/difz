#!/usr/bin/env bash

# Run host filesystem tests and the reproducible Nix checks in Debug mode.

set -u

errors=0

if ! tests/nix/test_flake_outputs.bash; then
	errors=$((errors + 1))
fi

# The sandbox may lack xattrs. Require their real-adapter assertions on the host.
if ! nix develop -c env DIFZ_REQUIRE_XATTR_TESTS=1 zig build test -Doptimize=Debug; then
	errors=$((errors + 1))
fi

# Exercise default directory metadata through the C boundary on the host.
if ! nix develop -c env -u DIFZ_TEST_DIRECTORY_OMIT DIFZ_PREBUILT=0 DIFZ=./zig-out/bin/difz bash tests/cli/test_cli.bash; then
	errors=$((errors + 1))
fi

# Prove Rust can use the installed C ABI in one mixed-language executable.
if ! nix develop -c bash tests/ffi/test_rust_lib.bash; then
	errors=$((errors + 1))
fi

# Codec candidates must cross-apply against the existing implementation.
if ! nix develop -c env DIFZ_ORACLE="$(pwd)/zig-out/bin/difz" bash tests/codec_rust/test; then
	errors=$((errors + 1))
fi

system="$(nix eval --impure --raw --expr builtins.currentSystem)"
if ! nix build -L \
	".#checks.${system}.test" \
	".#checks.${system}.benchmark-contract" \
	".#checks.${system}.windows-gnu"; then
	errors=$((errors + 1))
fi

exit "$errors"
